# One of: azure_cli, device_code, client_secret
SP_AUTH_MODE=azure_cli

# SharePoint Online tenant hostname, without scheme or path.
SP_TENANT_HOST=contoso.sharepoint.com

# Optional semicolon-separated site URLs. Used by sp_get_sites, which cannot
# enumerate all tenant sites through ordinary site-scoped SharePoint REST.
SP_SITE_URLS=https://contoso.sharepoint.com/sites/Operations;https://contoso.sharepoint.com/sites/Finance

# Required for device_code and client_secret modes.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

# Optional: maximum number of items accepted in one batch (1-50).
SP_MAX_BATCH_REQUESTS=50
